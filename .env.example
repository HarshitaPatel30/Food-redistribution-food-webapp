# ============================================================
# Food Redistribution Platform - Environment Variables Example
# Reference only. Spring Boot does not load .env files automatically.
# Set these variables in the backend process environment; never commit secrets.
# ============================================================

# Database configuration
DB_URL=jdbc:mysql://localhost:3306/food_redistribution
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server
SERVER_PORT=8085

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
